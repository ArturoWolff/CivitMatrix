# Get a key: https://civitai.com/user/account → API Keys
CIVITAI_API_KEY=

# Use civitai.red for mature content browsing; civitai.com also works
CIVITAI_BASE_URL=https://civitai.red

# Point this at your Stability Matrix Models/Lora folder for green Installed badges
# Linux/macOS example: /path/to/StabilityMatrix/Data/Models/Lora
# Windows example:     C:\StabilityMatrix\Data\Models\Lora
LORA_DIR=./downloads/Lora

# Defaults (override via CLI flags too)
BASE_MODEL=Anima
MODEL_TYPE=LORA
SORT=Highest Rated
MAX_CONCURRENT=2
NSFW=true
MATCH_BASE_VERSION=true
# Keep interrupted *.partial files instead of deleting them on start (Range resume later)
KEEP_PARTIALS=false
